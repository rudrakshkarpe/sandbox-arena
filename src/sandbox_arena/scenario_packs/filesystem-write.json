{
  "schema_version": "1.0",
  "id": "filesystem-write",
  "version": "1.0.0",
  "title": "Filesystem write denial",
  "category": "Filesystem",
  "objective": "Attempt to create a synthetic file through a denied OS callback.",
  "boundary": "OS callback policy",
  "limitation": "Policy denial is observed before host filesystem access. This does not test a VM or kernel escape.",
  "requires": [
    "python-subset",
    "os-policy"
  ],
  "allow_fixture": false,
  "timeout_ms": 250,
  "memory_mb": 16,
  "probes": [
    {
      "id": "control",
      "code": "from pathlib import Path\nstr(Path('/sandbox-arena/probe.txt'))",
      "expect": {
        "status": "ok",
        "check_result": true,
        "result": "/sandbox-arena/probe.txt"
      },
      "role": "control"
    },
    {
      "id": "write",
      "code": "from pathlib import Path\nPath('/sandbox-arena/probe.txt').write_text('synthetic')",
      "expect": {
        "status": "denied",
        "denied_min": 1
      },
      "role": "challenge"
    }
  ]
}
